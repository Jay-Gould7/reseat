BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
LASNA_RPC_URL=https://lasna-rpc.rnk.dev
BASE_CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585
BASE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Per-event reserve on the deployed factory, in wei (0.0001 Base test ETH).
BASE_EVENT_CALLBACK_WEI=100000000000000
# Private, testnet deployer only. Keep empty in version control.
DEPLOYER_PRIVATE_KEY=
# New sponsorship-enabled deployments only. A dedicated Lasna wallet pays for forwarding signed requests.
# Its public address is registered at binding. The private key belongs only on the relay server.
WAITLIST_RELAY_ADDRESS=
WAITLIST_RELAY_PRIVATE_KEY=
# Admission budgets per operation, in native wei. These do not change the factory's publish deposit.
WAITLIST_BASE_CALLBACK_WEI=10000000000000
WAITLIST_LASNA_TX_WEI=5000000000000000
WAITLIST_LASNA_EXECUTION_WEI=10000000000000000
# Optional absolute private persistent directory. Default: ~/.reseat/relay-state
WAITLIST_RELAY_STATE_DIR=
# For the README's loopback nginx reverse proxy. Leave empty for direct client connections.
WAITLIST_TRUSTED_PROXIES=

# Active deployment of the ab375d9 contracts. Only VITE_ settings reach the browser.
VITE_REACTIVE_ADDRESS=0xc1BD44Ab59f254fAC8DB1D0C2cDDf00D6Cf31742
VITE_FACTORY_ADDRESS=0xFA186f628F1F7DCA230b80E99e6c86F095c3BBc9
VITE_LASNA_START_BLOCK=9388397
VITE_BASE_START_BLOCK=64369230
# Keep trusted, retired deployments here when switching the four current settings above.
VITE_LEGACY_PLATFORMS='[{"factory":"0x30f8D0140C181cEb12Fd7f8325DD3c9e58520E3e","watcher":"0x86080d9B0a8A0F8244bAA756001A531986683a40","baseStart":62609418,"lasnaStart":9061849}]'
# Optional browser-safe RPC overrides. Public testnet endpoints are the defaults.
VITE_BASE_RPC_URL=
VITE_LASNA_RPC_URL=
